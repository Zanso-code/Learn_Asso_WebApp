# Copier vers .env.local (ignore par git) et renseigner depuis
# Supabase Dashboard -> Project Settings -> API Keys.
#
# Prendre la « Publishable key » (sb_publishable_...), pas la « Secret key ».
# Si le projet n'affiche encore que les anciennes cles, l'ancienne cle `anon`
# fait le meme travail — Supabase la deprecie fin 2026, la publishable key la
# remplace telle quelle, sans changement de code.
#
# Cette cle est publique par nature : elle est expediee au navigateur. Ce qui
# protege les donnees, c'est la RLS definie dans
# supabase/migrations/0001_init.sql, pas le secret de cette cle.
#
# Ne JAMAIS mettre ici la « Secret key » (sb_secret_... / service_role) :
# elle ignore la RLS et donnerait a chaque visiteur les donnees de toutes les
# associations.

VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
